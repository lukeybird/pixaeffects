{
  "cleanUrls": true,
  "trailingSlash": false,
  "framework": null,
  "buildCommand": "echo Static showcase assets ready",
  "installCommand": "echo No dependencies required",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/pixa-showcase/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
